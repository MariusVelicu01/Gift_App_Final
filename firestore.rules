rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Profil utilizator ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // toate scrierile merg prin Admin SDK (backend)

      // ─── Persoane dragi ──────────────────────────────────────────────
      match /lovedOnes/{lovedOneId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // scris doar prin backend (aplică limite abonament)

        // ─── Planuri cadou ─────────────────────────────────────────────
        match /giftPlans/{giftPlanId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if false;
        }
      }

      // ─── Alerte preț ─────────────────────────────────────────────────
      match /priceAlerts/{alertId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // ─── Push tokens ─────────────────────────────────────────────────
      match /pushTokens/{tokenId} {
        allow read, write: if false;
      }
    }

    // ─── Magazine partenere ───────────────────────────────────────────────
    match /partnerStores/{storeId} {
      allow read: if request.auth != null;
      allow write: if false;

      // ─── Produse (subcolecție, câte un document per produs) ─────────────
      match /products/{productId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ─── Orice altceva: blocat implicit ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
